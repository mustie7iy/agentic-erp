node_modules/
data/
.env
*.log
bin/

# binaries built in the repository root (go build ./cmd/...)
/erp-server
/erp-router
/erp-web
/erp
# and the same built inside their own directory (go build in cmd/<name>)
/cmd/erp/erp
/cmd/erp-server/erp-server
/cmd/erp-router/erp-router
/cmd/erp-web/erp-web

# per-user Claude Code state; .claude/settings.json, agents/ and hooks/ are shared
.claude/settings.local.json
.claude/scheduled_tasks.lock
dist/

# Terraform working directories; lock files are committed for the roots only.
deploy/terraform/**/.terraform/
deploy/terraform/modules/**/.terraform.lock.hcl
