{
  "uid": "erp-payments",
  "title": "ERP payments",
  "description": "Payment runs, proposals and bank files, and the payments context's events (ADR-0043).",
  "tags": [
    "erp"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "utc",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Runs proposed",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(erp_payment_runs_proposed)",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Runs failed, recent",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(erp_payment_runs_failed_recent)",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Bank files unacknowledged",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(erp_bank_files_unacknowledged)",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Oldest unacknowledged file",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(erp_bank_files_unacknowledged_age_seconds)",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Runs and proposals",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(erp_payment_runs_proposed)",
          "legendFormat": "runs proposed"
        },
        {
          "refId": "B",
          "expr": "max(erp_payment_proposals_queued)",
          "legendFormat": "proposals queued"
        },
        {
          "refId": "C",
          "expr": "max(erp_payment_runs_failed_recent)",
          "legendFormat": "runs failed"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Bank files",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(erp_bank_files_unacknowledged)",
          "legendFormat": "unacknowledged"
        },
        {
          "refId": "B",
          "expr": "max(erp_bank_files_rejected_recent)",
          "legendFormat": "rejected, recent"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Events published, 24h",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(erp_events_published_total{context=\"payments\"}[1d])) or vector(0)",
          "legendFormat": ""
        }
      ],
      "description": "Events the payments context published through the outbox in the last day."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Events published by event",
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 6,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event) (rate(erp_events_published_total{context=\"payments\"}[$__rate_interval]))",
          "legendFormat": "{{event}}"
        }
      ]
    }
  ]
}
