{
  "uid": "erp-cell-overview",
  "title": "ERP cell overview",
  "description": "The cell's golden signals: traffic, errors, latency per class, saturation (429s, work waiting, CPU and memory against requests and limits) and the outbox's and projectors' lag (ADR-0043).",
  "tags": [
    "erp"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "utc",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests per second",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(erp_http_requests_total[$__rate_interval]))",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Failed requests (5m)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "erp:http_availability_errors:ratio_rate5m",
          "legendFormat": ""
        }
      ],
      "description": "Share of counted requests that failed with a 5xx or a 429, from the SLO rules."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Outbox lag",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(erp_outbox_lag_seconds)",
          "legendFormat": ""
        }
      ],
      "description": "Age of the oldest event not yet published."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Projection lag",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(erp_projection_lag_seconds)",
          "legendFormat": ""
        }
      ],
      "description": "Age of the oldest event a projector has not yet applied."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Traffic by status",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (rate(erp_http_requests_total[$__rate_interval]))",
          "legendFormat": "{{code}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Traffic by latency class",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (class) (sum by (operation) (rate(erp_http_requests_total[$__rate_interval])) * on (operation) group_left (class) group by (operation, class) (erp_operation_info))",
          "legendFormat": "{{class}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Failed requests",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "erp:http_availability_errors:ratio_rate5m",
          "legendFormat": "5m"
        },
        {
          "refId": "B",
          "expr": "erp:http_availability_errors:ratio_rate1h",
          "legendFormat": "1h"
        }
      ],
      "description": "The SLO's failure ratio: 5xx and 429 over requests that count."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Operations failing most",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (operation) (rate(erp_http_requests_total{code=~\"5..\"}[$__rate_interval])))",
          "legendFormat": "{{operation}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Latency p95 by class",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (class, le) (sum by (operation, le) (rate(erp_http_request_duration_seconds_bucket[$__rate_interval])) * on (operation) group_left (class) group by (operation, class) (erp_operation_info)))",
          "legendFormat": "{{class}}"
        }
      ],
      "description": "Thresholds: read 0.05 s, list 0.15 s, write 0.2 s, approval 0.15 s, report 1 s."
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Slow requests by class (5m)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "erp:http_latency_slow:ratio_rate5m",
          "legendFormat": "{{class}}"
        }
      ],
      "description": "Share of each class's requests slower than its threshold; the budget is 5%."
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Turned away (429)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(erp_http_requests_total{code=\"429\"}[$__rate_interval])) / sum(rate(erp_http_requests_total[$__rate_interval]))",
          "legendFormat": "429 share"
        }
      ],
      "description": "Saturation: the share of requests the cell's limits turned away."
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Work waiting",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(erp_outbox_backlog)",
          "legendFormat": "outbox"
        },
        {
          "refId": "B",
          "expr": "max(erp_projection_backlog)",
          "legendFormat": "projections"
        },
        {
          "refId": "C",
          "expr": "max(erp_simulations_queued)",
          "legendFormat": "simulations"
        },
        {
          "refId": "D",
          "expr": "max(erp_approvals_pending)",
          "legendFormat": "approvals"
        }
      ],
      "description": "Saturation: rows waiting on the relay, the projectors, the simulator and people."
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Outbox and projection lag",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(erp_outbox_lag_seconds)",
          "legendFormat": "outbox"
        },
        {
          "refId": "B",
          "expr": "max(erp_projection_lag_seconds)",
          "legendFormat": "projections"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Gauges that could not be read",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gauge) (rate(erp_gauge_read_errors_total[$__rate_interval]))",
          "legendFormat": "{{gauge}}"
        }
      ],
      "description": "A gauge whose query failed on scrape reports nothing; this counts the failures."
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "CPU used of requested",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (rate(container_cpu_usage_seconds_total{namespace=\"erp\", container!=\"\"}[$__rate_interval])) / sum by (container) (kube_pod_container_resource_requests{namespace=\"erp\", resource=\"cpu\"})",
          "legendFormat": "{{container}}"
        }
      ],
      "description": "Saturation: each container's CPU (cAdvisor, all its Pods) over what it requested (kube-state-metrics). The cell sets no CPU limits, so above 1 it borrows idle CPU from the node and is the first to slow when the node is busy."
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Memory used of limit",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (container) (container_memory_working_set_bytes{namespace=\"erp\", container!=\"\"} / on (namespace, pod, container) kube_pod_container_resource_limits{namespace=\"erp\", resource=\"memory\"})",
          "legendFormat": "{{container}}"
        }
      ],
      "description": "Saturation: the fullest Pod's working set over its memory limit, per container; at 1 the kernel kills it (OOM)."
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Container restarts (1h)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (increase(kube_pod_container_status_restarts_total{namespace=\"erp\"}[1h]))",
          "legendFormat": "{{container}}"
        }
      ],
      "description": "Restarts of the cell's containers over the last hour: OOM kills and failed probes among them."
    }
  ]
}
