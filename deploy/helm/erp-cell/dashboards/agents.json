{
  "uid": "erp-agents",
  "title": "ERP agents",
  "description": "Agents' model use (tokens, cost, latency), how often people override them, and the agents context's events (ADR-0043).",
  "tags": [
    "erp"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "utc",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Override rate, 1d",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(erp:agent_override_rate:ratio_rate1d)",
          "legendFormat": ""
        }
      ],
      "description": "Share of agent-raised proposals a person rejected or changed before approving."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Model cost, 24h",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(erp_model_cost_micro_total[1d])) / 1e6",
          "legendFormat": ""
        }
      ],
      "description": "In the currency's major units, summed over currencies; see the panel by currency."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Simulations queued",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(erp_simulations_queued)",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Model calls failing",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(erp_model_call_duration_seconds_count{status!=\"succeeded\"}[$__rate_interval])) / sum(rate(erp_model_call_duration_seconds_count[$__rate_interval]))",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Tokens by kind",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(erp_model_tokens_total[$__rate_interval]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Tokens by agent",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (agent_kind, alias) (rate(erp_model_tokens_total[$__rate_interval]))",
          "legendFormat": "{{agent_kind}} {{alias}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Cost per hour by currency",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (currency) (increase(erp_model_cost_micro_total[1h])) / 1e6",
          "legendFormat": "{{currency}}"
        }
      ],
      "description": "Cost trend in each currency's major units."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Model call latency p95",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (alias, le) (rate(erp_model_call_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{alias}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Model calls by status",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(erp_model_call_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Override rate by agent, 1d",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "erp:agent_override_rate:ratio_rate1d",
          "legendFormat": "{{agent_kind}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Proposals decided",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (agent_kind, decision) (rate(erp_agent_proposals_decided_total[$__rate_interval]))",
          "legendFormat": "{{agent_kind}} {{decision}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Events published, 24h",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(erp_events_published_total{context=\"agents\"}[1d])) or vector(0)",
          "legendFormat": ""
        }
      ],
      "description": "Events the agents context published through the outbox in the last day."
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Events published by event",
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 0,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event) (rate(erp_events_published_total{context=\"agents\"}[$__rate_interval]))",
          "legendFormat": "{{event}}"
        }
      ]
    }
  ]
}
