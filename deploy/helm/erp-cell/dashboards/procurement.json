{
  "uid": "erp-procurement",
  "title": "ERP procurement",
  "description": "Requisitions, orders and receipts as the procurement context's events, and the approvals waiting on people (ADR-0043).",
  "tags": [
    "erp"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "utc",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Approvals pending",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(erp_approvals_pending)",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Oldest pending approval",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(erp_approvals_pending_age_seconds)",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Events published, 24h",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(erp_events_published_total{context=\"procurement\"}[1d])) or vector(0)",
          "legendFormat": ""
        }
      ],
      "description": "Events the procurement context published through the outbox in the last day."
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Events published by event",
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event) (rate(erp_events_published_total{context=\"procurement\"}[$__rate_interval]))",
          "legendFormat": "{{event}}"
        }
      ]
    }
  ]
}
