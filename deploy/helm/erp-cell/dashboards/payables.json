{
  "uid": "erp-payables",
  "title": "ERP payables",
  "description": "Supplier invoices held and parked, and the payables context's events (ADR-0043).",
  "tags": [
    "erp"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "utc",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Invoices on hold",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(erp_supplier_invoices_on_hold)",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Invoices parked, stale",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(erp_supplier_invoices_parked_stale)",
          "legendFormat": ""
        }
      ],
      "description": "Parked invoices no one has touched for long."
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Invoices held and parked",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(erp_supplier_invoices_on_hold)",
          "legendFormat": "on hold"
        },
        {
          "refId": "B",
          "expr": "max(erp_supplier_invoices_parked_stale)",
          "legendFormat": "parked, stale"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Events published, 24h",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(erp_events_published_total{context=\"payables\"}[1d])) or vector(0)",
          "legendFormat": ""
        }
      ],
      "description": "Events the payables context published through the outbox in the last day."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Events published by event",
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 6,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event) (rate(erp_events_published_total{context=\"payables\"}[$__rate_interval]))",
          "legendFormat": "{{event}}"
        }
      ]
    }
  ]
}
